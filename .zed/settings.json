{
  // Project-level Zed settings for naplazi. Global settings live in ~/.config/zed/settings.json
  // (agent.tool_permissions is global-only; Zed strips it from local settings).
  //
  // Editor formatting mirrors the repo toolchain: Biome for TS/JS/JSON, Prettier for MD/YAML.
  // Biome runs via its Zed extension (language server); Prettier is built in and reads
  // prettier.config.js. There is no ESLint here, so Biome also owns import ordering.
  "languages": {
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.fixAll.biome": true, "source.organizeImports.biome": true },
      "format_on_save": "on"
    },
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.fixAll.biome": true, "source.organizeImports.biome": true },
      "format_on_save": "on"
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },
    "JSONC": {
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },
    "Markdown": {
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "YAML": {
      "formatter": "prettier",
      "format_on_save": "on"
    }
  }
}
