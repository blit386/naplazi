{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/format-file.sh\"",
            "timeout": 30
          }
        ],
        "matcher": "Edit|MultiEdit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/shell-safety.sh",
            "timeout": 10
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(jq -r \".tool_input.file_path // empty\"); case \"$FILE\" in *pnpm-lock.yaml|*package-lock.json|*.lock|*.env|*.env.*) echo \"[BLOCKED] Lock files and .env files are edited by hand or by the package manager, not by the agent.\" >&2; exit 2 ;; esac"
          }
        ],
        "matcher": "Edit|MultiEdit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && BLIT_PM_INSTALL='pnpm install' sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 300
          }
        ],
        "matcher": "startup|resume|clear|compact|fork"
      }
    ]
  }
}
