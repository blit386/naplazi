{
  "name": "naplazi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write . && prettier --write \"**/*.{md,mdx,mdc,yml,yaml}\"",
    "format:check": "biome check . && prettier --check \"**/*.{md,mdx,mdc,yml,yaml}\"",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "spellcheck": "cspell \"src/**/*.{ts,js}\" \"*.md\" --no-progress",
    "knip": "knip",
    "preflight": "pnpm run format:check && pnpm run typecheck && pnpm run spellcheck && pnpm run knip && pnpm run build",
    "deploy": "vite build && wrangler pages deploy dist --project-name=naplazi --branch=main",
    "prepare": "husky",
    "play": "node scripts/play.mjs",
    "sprites": "node --experimental-strip-types tools/make-sprites.mjs"
  },
  "dependencies": {
    "blit386": "^1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@blit386/kit": "^1.7.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "cspell": "^10.3.3",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "wrangler": "4.114.0"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
