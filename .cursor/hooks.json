{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "sh scripts/format-file.sh",
        "matcher": "Write|TabWrite",
        "timeout": 30,
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/shell-safety-run.cjs .cursor/hooks/shell-safety.sh",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
